cat > "$HOME/bin/opc" <<'EOF'
#!/usr/bin/env bash

set -Eeuo pipefail

# ============================================================
# SSH KEY PAIR DISCOVERY
# ============================================================

find_ssh_keys() {
    local dir="$1"
    local pub priv

    SSH_KEY_FILE=""
    SSH_PUB_FILE=""

    # Exact known names take priority
    if [[ -f "$dir/github_opencode" && -f "$dir/github_opencode.pub" ]]; then
        SSH_KEY_FILE="$dir/github_opencode"
        SSH_PUB_FILE="$dir/github_opencode.pub"
        return 0
    fi

    # Otherwise: any *.pub with a matching private key beside it
    for pub in "$dir"/*.pub; do
        [[ -e "$pub" ]] || continue
        priv="${pub%.pub}"
        if [[ -f "$priv" && -s "$priv" ]]; then
            SSH_KEY_FILE="$priv"
            SSH_PUB_FILE="$pub"
            return 0
        fi
    done

    return 1
}

# ============================================================
# CONFIGURATION
# ============================================================

SESSION="opencode"

CONFIG_DIR="$HOME/.config/colab-opencode"
API_KEY_FILE="$CONFIG_DIR/api_key"

SSH_KEY_DIR_FILE="$CONFIG_DIR/ssh_key_dir"

PROVIDER_FILE="$CONFIG_DIR/provider.json"

SSH_KEY_DIR=""
if [[ -s "$SSH_KEY_DIR_FILE" ]]; then
    SSH_KEY_DIR="$(cat "$SSH_KEY_DIR_FILE")"
fi

if [[ -n "$SSH_KEY_DIR" ]]; then
    find_ssh_keys "$SSH_KEY_DIR" || true
fi

DOWNLOAD_DIR="$HOME/storage/downloads"

if [[ ! -d "$DOWNLOAD_DIR" ]]; then
    DOWNLOAD_DIR="$HOME/Downloads"
fi

if [[ ! -d "$DOWNLOAD_DIR" ]]; then
    DOWNLOAD_DIR="$HOME"
fi

export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

if command -v python >/dev/null 2>&1; then
    PY=python
else
    PY=python3
fi

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

mkdir -p "$CONFIG_DIR" "$DOWNLOAD_DIR"

# ============================================================
# HELPERS
# ============================================================

log() {
    echo "[opc] $*"
}

die() {
    echo "[opc] ERROR: $*" >&2
    exit 1
}

# ============================================================
# PROVIDER
# ============================================================

ensure_provider() {

    if [[ ! -s "$PROVIDER_FILE" ]]; then
        die "No provider configured. Set it up with: opc -api"
    fi
}

# ============================================================
# SESSION
# ============================================================

ensure_session() {

    local status

    status="$(colab status -s "$SESSION" 2>&1 || true)"

    if grep -Fq "Session '$SESSION' not found" <<< "$status"; then
        log "Creating CPU session..."
        colab new -s "$SESSION"
    else
        log "Using existing session."
    fi
}

# ============================================================
# RECREATE SESSION
# ============================================================

recreate_session() {

    log "Stopping old session '$SESSION' (if any)..."

    colab stop -s "$SESSION" >/dev/null 2>&1 || true

    log "Creating a fresh session '$SESSION'..."

    colab new -s "$SESSION"

    check_local_files
    ensure_provider
    upload_secrets
    setup_opencode
}

# ============================================================
# SSH KEY FOLDER
# ============================================================

set_sshkey_dir() {
    local dir ans

    echo
    read -r -p "[opc] Do you already have GitHub SSH keys? [y/N]: " ans

    if [[ "$ans" =~ ^[yY] ]]; then
        while true; do
            read -r -p "[opc] Folder with your keys: " dir
            dir="${dir/#\~/$HOME}"
            [[ -n "$dir" ]] && break
            echo "[opc] Path cannot be empty." >&2
        done

        if ! find_ssh_keys "$dir"; then
            echo "[opc] WARNING: no SSH key pair found in $dir" >&2
            read -r -p "[opc] Save folder anyway? [y/N]: " ans
            [[ "$ans" =~ ^[yY] ]] || die "Aborted."
        fi
    else
        if ! command -v ssh-keygen >/dev/null 2>&1; then
            die "ssh-keygen is not installed. Run the installer first: ./opc"
        fi

        while true; do
            read -r -p "[opc] Where to save the keys: " dir
            dir="${dir/#\~/$HOME}"
            [[ -n "$dir" ]] && break
            echo "[opc] Path cannot be empty." >&2
        done
        mkdir -p "$dir"
        chmod 700 "$dir"

        ssh-keygen -q -t ed25519 -C "opc-github" -f "$dir/github_opencode" -N ""

        chmod 600 "$dir/github_opencode"
        chmod 644 "$dir/github_opencode.pub"

        echo
        echo "[opc] Add this PUBLIC key to GitHub:"
        echo "[opc] https://github.com/settings/ssh/new"
        echo
        cat "$dir/github_opencode.pub"
        echo
    fi

    printf '%s' "$dir" > "$SSH_KEY_DIR_FILE"
    chmod 600 "$SSH_KEY_DIR_FILE"
    log "SSH key folder saved: $dir"
}

