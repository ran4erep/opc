# ============================================================
# UPLOAD ALL CURRENT DIRECTORY
# ============================================================

upload_all() {

    log "Packing current directory..."

    local archive="$TMP_DIR/opc_upload.zip"

    "$PY" - "$PWD" "$archive" <<'PY'
import os
import sys
import zipfile

root = os.path.abspath(sys.argv[1])
archive = sys.argv[2]

with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as z:
    for current, dirs, files in os.walk(root, followlinks=False):

        dirs[:] = [
            d for d in dirs
            if not os.path.islink(os.path.join(current, d))
        ]

        for name in files:
            path = os.path.join(current, name)

            if os.path.islink(path):
                continue

            relative = os.path.relpath(path, root)
            z.write(path, relative)

print("[opc] Archive created.")
PY

    log "Uploading archive..."

    colab upload -s "$SESSION" \
        "$archive" \
        /content/opc_upload.zip

    cat > "$TMP_DIR/unpack.py" <<'PY'
import zipfile
from pathlib import Path

archive = Path("/content/opc_upload.zip")
destination = Path("/content").resolve()

with zipfile.ZipFile(archive) as z:
    for item in z.infolist():
        target = (destination / item.filename).resolve()

        if target != destination and destination not in target.parents:
            raise RuntimeError("Unsafe archive path: " + item.filename)

    z.extractall(destination)

archive.unlink(missing_ok=True)

print("[opc] Files extracted into /content.")
PY

    log "Extracting archive..."

    colab exec -s "$SESSION" -f "$TMP_DIR/unpack.py"
}

