# ============================================================
# REMOTE SETUP
# ============================================================

setup_opencode() {

    log "Preparing remote environment..."

    cat > "$TMP_DIR/setup.py" <<'PY'
import os
import re
import json
import shutil
import subprocess
from pathlib import Path

home = Path.home()

def run(command):
    subprocess.run(command, check=True)

# ------------------------------------------------------------
# Install system dependencies
# ------------------------------------------------------------

required = ["git", "ssh", "ssh-keyscan", "curl"]

missing = [
    item for item in required
    if shutil.which(item) is None
]

if missing:
    print("[opc] Installing system dependencies...")
    run(["apt-get", "update", "-qq"])
    run([
        "apt-get", "install", "-y", "-qq",
        "git",
        "openssh-client",
        "curl",
        "ca-certificates"
    ])

# ------------------------------------------------------------
# Install OpenCode 2
# ------------------------------------------------------------

candidates = [
    shutil.which("opencode2"),
    str(home / ".opencode" / "bin" / "opencode2"),
    str(home / ".local" / "bin" / "opencode2"),
    str(home / ".opencode" / "bin" / "opencode"),
    str(home / ".local" / "bin" / "opencode"),
]

binary = next(
    (p for p in candidates if p and Path(p).is_file()),
    None
)

if not binary:
    print("[opc] Installing OpenCode 2...")
    run([
        "bash",
        "-lc",
        "curl -fsSL https://opencode.ai/v2/install | bash"
    ])

    candidates = [
        shutil.which("opencode2"),
        str(home / ".opencode" / "bin" / "opencode2"),
        str(home / ".local" / "bin" / "opencode2"),
        str(home / ".opencode" / "bin" / "opencode"),
        str(home / ".local" / "bin" / "opencode"),
    ]

    binary = next(
        (p for p in candidates if p and Path(p).is_file()),
        None
    )

if not binary:
    raise RuntimeError("OpenCode 2 binary not found.")

version = subprocess.run(
    [binary, "--version"],
    capture_output=True,
    text=True
)

version_text = (version.stdout + version.stderr).strip()

print("[opc] OpenCode version:", version_text)

if not re.search(r"(^|[^0-9])2\.", version_text):
    raise RuntimeError(
        "The installed binary is not confirmed as OpenCode 2. "
        "Detected version: " + version_text
    )

# ------------------------------------------------------------
# Load provider spec (if uploaded), else fall back to Inception
# ------------------------------------------------------------

opencode_config_dir = home / ".config" / "opencode"
opencode_config_dir.mkdir(parents=True, exist_ok=True)

provider = None
provider_file = Path("/content/opc_provider.json")

if provider_file.is_file():
    try:
        provider = json.loads(provider_file.read_text())
    except Exception:
        provider = None
    provider_file.unlink(missing_ok=True)

# ------------------------------------------------------------
# Install API key
# ------------------------------------------------------------

api_env_var = ""
api_key_file = None

if provider is not None:
    api_env_var = str(provider.get("env") or "")
    stored_key = str(provider.get("api_key") or "")

    if stored_key:
        api_key_file = opencode_config_dir / "provider_key"
        api_key_file.write_text(stored_key)
        api_key_file.chmod(0o600)
    elif (opencode_config_dir / "provider_key").is_file():
        api_key_file = opencode_config_dir / "provider_key"
else:
    uploaded_api_key = Path("/content/inception_api_key")

    if not uploaded_api_key.is_file():
        raise RuntimeError("Inception API key was not uploaded.")

    api_key = uploaded_api_key.read_text().strip()

    if not api_key:
        raise RuntimeError("Inception API key is empty.")

    api_env_var = "INCEPTION_API_KEY"
    api_key_file = opencode_config_dir / "inception_api_key"
    api_key_file.write_text(api_key)
    api_key_file.chmod(0o600)
    uploaded_api_key.unlink(missing_ok=True)

# ------------------------------------------------------------
# Configure GitHub SSH
# ------------------------------------------------------------

ssh_dir = home / ".ssh"
ssh_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
ssh_dir.chmod(0o700)

private_source = Path("/content/.opc_github_key")
public_source = Path("/content/.opc_github_key.pub")

if not private_source.is_file():
    raise RuntimeError("GitHub private key was not uploaded.")

if not public_source.is_file():
    raise RuntimeError("GitHub public key was not uploaded.")

private_key = ssh_dir / "github_opencode"
public_key = ssh_dir / "github_opencode.pub"

shutil.copy2(private_source, private_key)
shutil.copy2(public_source, public_key)

private_key.chmod(0o600)
public_key.chmod(0o644)

# Remove temporary uploaded copies
private_source.unlink(missing_ok=True)
public_source.unlink(missing_ok=True)

# SSH config
ssh_config = ssh_dir / "config"

ssh_config.write_text("""Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github_opencode
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30
""")

ssh_config.chmod(0o600)

# ------------------------------------------------------------
# GitHub host key
# ------------------------------------------------------------

known_hosts = ssh_dir / "known_hosts"

scan = subprocess.run(
    ["ssh-keyscan", "-H", "github.com"],
    capture_output=True,
    text=True,
    timeout=20
)

if scan.returncode == 0 and scan.stdout.strip():
    with known_hosts.open("a") as f:
        f.write(scan.stdout)

known_hosts.chmod(0o600)

# ------------------------------------------------------------
# Configure Git to use SSH for GitHub
# ------------------------------------------------------------

run([
    "git", "config", "--global",
    "url.git@github.com:.insteadOf",
    "https://github.com/"
])

# ------------------------------------------------------------
# Check GitHub authentication
# ------------------------------------------------------------

auth = subprocess.run(
    ["ssh", "-T", "git@github.com"],
    capture_output=True,
    text=True,
    timeout=25
)

auth_text = auth.stdout + auth.stderr

match = re.search(r"Hi ([^!]+)!", auth_text)

if match:
    username = match.group(1).strip()

    print("[opc] GitHub authenticated as:", username)

    existing_name = subprocess.run(
        ["git", "config", "--global", "user.name"],
        capture_output=True,
        text=True
    )

    existing_email = subprocess.run(
        ["git", "config", "--global", "user.email"],
        capture_output=True,
        text=True
    )

    if not existing_name.stdout.strip():
        run([
            "git", "config", "--global",
            "user.name", username
        ])

    if not existing_email.stdout.strip():
        run([
            "git", "config", "--global",
            "user.email",
            username + "@users.noreply.github.com"
        ])

else:
    print("[opc] WARNING: GitHub authentication not confirmed.")
    print(auth_text)

# ------------------------------------------------------------
# OpenCode provider configuration
# ------------------------------------------------------------

if provider is not None:
    prov_id = str(provider.get("name") or "custom")
    pkg = str(provider.get("package") or "@opencode/ai/providers/openai-compatible")
    base_url = str(provider.get("base_url") or "")
    model_id = str(provider.get("model") or "")

    if not model_id:
        raise RuntimeError("Provider model is not specified.")

    prov_cfg = {
        "name": prov_id,
        "package": pkg,
    }

    if api_env_var:
        prov_cfg["env"] = [api_env_var]

    if base_url:
        prov_cfg["settings"] = {"baseURL": base_url}

    prov_cfg["models"] = {
        model_id: {
            "name": model_id,
            "limit": {
                "context": int(provider.get("limit_context", 1000000)),
                "output": int(provider.get("limit_output", 131072)),
            },
            "settings": {"reasoningEffort": "medium"},
            "body": {"reasoning_effort": "medium"},
        }
    }

    config = {
        "$schema": "https://opencode.ai/config.json",
        "model": f"{prov_id}/{model_id}",
        "providers": {prov_id: prov_cfg},
    }

else:
    config = {
        "$schema": "https://opencode.ai/config.json",
        "model": "inception/mercury-3",
        "providers": {
            "inception": {
                "name": "Inception Labs",
                "env": ["INCEPTION_API_KEY"],
                "package": "@opencode/ai/providers/openai-compatible",
                "settings": {
                    "baseURL": "https://api.inceptionlabs.ai/v1"
                },
                "models": {
                    "mercury-3": {
                        "name": "Mercury 3",
                        "limit": {
                            "context": 1000000,
                            "output": 131072
                        },
                        "settings": {
                            "reasoningEffort": "medium"
                        },
                        "body": {
                            "reasoning_effort": "medium"
                        }
                    }
                }
            }
        }
    }

(opencode_config_dir / "opencode.json").write_text(
    json.dumps(config, indent=2)
)

# Preserve previously requested CLI preferences
cli_config = {
    "$schema": "https://opencode.ai/v2/cli.json",
    "animations": True,
    "session": {
        "scrollbar": True,
        "permissions": "autoaccept"
    },
    "scroll": {
        "speed": 4.0,
        "acceleration": True
    },
    "attention": {
        "notifications": True,
        "sound": True,
        "volume": 1.0
    }
}

(opencode_config_dir / "cli.json").write_text(
    json.dumps(cli_config, indent=2)
)

# ------------------------------------------------------------
# Bash autostart
# ------------------------------------------------------------

bashrc = home / ".bashrc"

content = bashrc.read_text() if bashrc.exists() else ""

marker = "# COLAB_OPENCODE_AUTOSTART"

if marker in content:
    content = content.split(marker)[0]

env_export = ""
if api_key_file is not None:
    env_export = f'export {api_env_var}="$(cat \'{api_key_file}\')"'

block = f"""
{marker}

export PATH="{home}/.opencode/bin:{home}/.local/bin:$PATH"
{env_export}

if [[ $- == *i* ]] && [[ -z "$COLAB_OPENCODE_RUNNING" ]]; then
    export COLAB_OPENCODE_RUNNING=1
    clear
    "{binary}"
fi
"""

bashrc.write_text(content.rstrip() + "\n\n" + block)

print("[opc] Remote setup completed.")
PY

    colab exec -s "$SESSION" -f "$TMP_DIR/setup.py"
}

