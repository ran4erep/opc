#!/usr/bin/env bash

# Установщик команды 'opc' (Google Colab + OpenCode 2).
# Скопируй этот файл на целевую машину и запусти:
#     ./opc
#
# Установщик делает ВСЁ сам:
#   • ставит python3 и pip, если их нет;
#   • ставит Google Colab CLI (pip install google-colab-cli);
#   • спрашивает провайдера, модель и API ключ;
#   • спрашивает папку с GitHub SSH-ключами (или генерирует новые);
#   • добавляет ~/bin в PATH (в ~/.bashrc или ~/.profile);
#   • создаёт ~/bin/opc и делает её исполняемой;
#   • сохраняет прежнюю версию как ~/bin/opc.backup.
#
# Сама команда opc НИЧЕГО не ставит — она только проверяет
# и использует то, что подготовил установщик.
#
# Останется сделать вручную на новой машине:
#   • авторизация Google (colab выполнит её при первом запуске)

set -euo pipefail

CONFIG_DIR="$HOME/.config/colab-opencode"
API_KEY_FILE="$CONFIG_DIR/api_key"
SSH_KEY_DIR_FILE="$CONFIG_DIR/ssh_key_dir"
PROVIDER_FILE="$CONFIG_DIR/provider.json"

mkdir -p "$HOME/bin" "$CONFIG_DIR"

if [[ -f "$HOME/bin/opc" ]]; then
    cp "$HOME/bin/opc" "$HOME/bin/opc.backup"
fi

# ============================================================
# BOOTSTRAP: python3 + pip + Google Colab CLI
# ============================================================

run_as_root() {
    if [[ $(id -u) -eq 0 ]]; then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        "$@"
    fi
}

ensure_python() {
    command -v python3 >/dev/null 2>&1 && return 0
    command -v python >/dev/null 2>&1 && return 0

    echo "[opc] python3 not found, installing..."

    if command -v apt-get >/dev/null 2>&1; then
        run_as_root apt-get update -qq
        run_as_root apt-get install -y -qq python3 python3-pip curl ca-certificates
    elif command -v pkg >/dev/null 2>&1; then
        pkg install -y python python-pip curl
    elif command -v dnf >/dev/null 2>&1; then
        run_as_root dnf install -y python3 python3-pip curl
    elif command -v pacman >/dev/null 2>&1; then
        run_as_root pacman -Sy --noconfirm python python-pip curl
    else
        echo "[opc] ERROR: cannot install python3 automatically." >&2
        exit 1
    fi
}

ensure_pip() {
    local py
    py="$(command -v python3 || command -v python)"

    if "$py" -m pip --version >/dev/null 2>&1; then
        return 0
    fi

    echo "[opc] pip not found, installing..."

    if command -v apt-get >/dev/null 2>&1; then
        run_as_root apt-get install -y -qq python3-pip
    elif command -v pkg >/dev/null 2>&1; then
        pkg install -y python-pip
    else
        echo "[opc] ERROR: cannot install pip automatically." >&2
        exit 1
    fi
}

ensure_colab_cli() {
    local py
    py="$(command -v python3 || command -v python)"

    if ! command -v colab >/dev/null 2>&1; then
        echo "[opc] Installing Google Colab CLI..."

        if "$py" -m pip install --user --upgrade google-colab-cli; then
            :
        elif "$py" -m pip install --user --break-system-packages --upgrade google-colab-cli; then
            :
        else
            echo "[opc] ERROR: cannot install google-colab-cli." >&2
            echo "[opc] Try manually: $py -m pip install --user --upgrade google-colab-cli" >&2
            exit 1
        fi
    else
        echo "[opc] Checking for Google Colab CLI updates..."

        "$py" -m pip install --user --upgrade google-colab-cli --quiet 2>/dev/null || \
        "$py" -m pip install --user --break-system-packages --upgrade google-colab-cli --quiet 2>/dev/null || true
    fi
}

ensure_path() {
    local rc
    if [[ -f "$HOME/.bashrc" ]]; then
        rc="$HOME/.bashrc"
    else
        rc="$HOME/.profile"
    fi

    if ! grep -q 'PATH="$HOME/bin:$PATH"' "$rc" 2>/dev/null; then
        printf '\n# added by opc installer\nexport PATH="$HOME/bin:$PATH"\n' >> "$rc"
        echo "[opc] Added ~/bin to PATH in $rc"
    fi
}

has_ssh_pair() {
    local dir="$1" pub priv

    for pub in "$dir"/*.pub; do
        [[ -e "$pub" ]] || continue
        priv="${pub%.pub}"
        if [[ -f "$priv" && -s "$priv" ]]; then
            return 0
        fi
    done

    return 1
}

