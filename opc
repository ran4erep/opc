    local i=1 e name disp pkg base_url env def_model models ans key model mchoice
    local -a mlist
    for e in "${db[@]}"; do
        printf '  %2d) %s\n' "$i" "$(printf '%s' "$e" | cut -d'|' -f2)"
        i=$((i+1))
    done

    read -r -p "[opc] Number [1-$((i-1))]: " ans
    [[ "$ans" =~ ^[0-9]+$ ]] && (( ans >= 1 && ans < i )) || die "Invalid choice."

    e="${db[$((ans-1))]}"
    IFS='|' read -r name disp pkg base_url env def_model models <<< "$e"

    if [[ "$name" == "custom" ]]; then
        read -r -p "[opc] Provider name: " name
        [[ -n "$name" ]] || die "Provider name is required."
        read -r -p "[opc] Base URL (e.g. https://api.example.com/v1): " base_url
        [[ -n "$base_url" ]] || die "Base URL is required."
        env="$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]' | tr -cs '[:alnum:]' '_')_API_KEY"
    fi

    key=""
    if [[ -n "$env" ]]; then
        read -rsp "[opc] API key for $disp: " key
        echo
    fi

    if [[ -n "$models" ]]; then
        IFS=',' read -ra mlist <<< "$models"

        echo
        echo "[opc] Choose model:"

        local mi=1 m
        for m in "${mlist[@]}"; do
            printf '  %2d) %s\n' "$mi" "$m"
            mi=$((mi+1))
        done

        read -r -p "[opc] Number [1-$((mi-1))], or type a custom model ID: " mchoice

        if [[ "$mchoice" =~ ^[0-9]+$ ]] && (( mchoice >= 1 && mchoice < mi )); then
            model="${mlist[$((mchoice-1))]}"
        else
            model="$mchoice"
        fi
    else
        read -r -p "[opc] Model: " model
    fi

    [[ -n "$model" ]] || die "Model is required."

    "$PY" - "$PROVIDER_FILE" "$name" "$disp" "$pkg" "$base_url" "$env" "$key" "$model" <<'PY'
import json
import sys

path, name, disp, pkg, base_url, env_var, key, model = sys.argv[1:]

data = {
    "name": name,
    "label": disp,
    "package": pkg,
    "base_url": base_url,
    "env": env_var,
    "api_key": key,
    "model": model,
    "limit_context": 1000000,
    "limit_output": 131072,
}

with open(path, "w") as f:
    json.dump(data, f, indent=2)
PY

    chmod 600 "$PROVIDER_FILE"
    log "Provider saved: $disp ($model)"
}

