ensure_ssh_keygen() {
    command -v ssh-keygen >/dev/null 2>&1 && return 0

    echo "[opc] Installing ssh-keygen (openssh-client)..."

    if command -v apt-get >/dev/null 2>&1; then
        run_as_root apt-get update -qq
        run_as_root apt-get install -y -qq openssh-client
    elif command -v pkg >/dev/null 2>&1; then
        pkg install -y openssh
    elif command -v dnf >/dev/null 2>&1; then
        run_as_root dnf install -y openssh-clients
    elif command -v pacman >/dev/null 2>&1; then
        run_as_root pacman -Sy --noconfirm openssh
    else
        echo "[opc] WARNING: cannot install ssh-keygen automatically." >&2
        return 1
    fi
}

ask_sshkey_dir() {
    local dir default ans
    default="$HOME/.ssh"

    if [[ -d "$HOME/storage/downloads" ]]; then
        default="$HOME/storage/downloads"
    fi

    echo
    read -r -p "[opc] Do you already have GitHub SSH keys? [y/N]: " ans

    if [[ "$ans" =~ ^[yY] ]]; then
        while true; do
            read -r -p "[opc] Folder with your keys: " dir
            dir="${dir/#\~/$HOME}"
            [[ -n "$dir" ]] && break
            echo "[opc] Path cannot be empty." >&2
        done

        if ! has_ssh_pair "$dir"; then
            echo "[opc] WARNING: no SSH key pair (private + .pub) found in $dir" >&2
            read -r -p "[opc] Save folder anyway? [y/N]: " ans
            [[ "$ans" =~ ^[yY] ]] || {
                echo "[opc] Aborted, folder not saved."
                return 1
            }
        fi
    else
        echo "[opc] OK, I will generate a new GitHub SSH key pair."

        if ! ensure_ssh_keygen; then
            echo "[opc] Cancelled." >&2
            return 1
        fi

        while true; do
            read -r -p "[opc] Where to save the keys: " dir
            dir="${dir/#\~/$HOME}"
            [[ -n "$dir" ]] && break
            echo "[opc] Path cannot be empty." >&2
        done
        mkdir -p "$dir"
        chmod 700 "$dir"

        ssh-keygen -q -t ed25519 -C "opc-github" -f "$dir/github_opencode" -N ""

        chmod 600 "$dir/github_opencode"
        chmod 644 "$dir/github_opencode.pub"

        echo
        echo "[opc] Keys created:"
        echo "[opc]   private: $dir/github_opencode"
        echo "[opc]   public:  $dir/github_opencode.pub"
        echo
        echo "[opc] ============================================================"
        echo "[opc] Add the PUBLIC key to GitHub:"
        echo "[opc]   1. Open https://github.com/settings/ssh/new"
        echo "[opc]   2. Title: anything (e.g. \"opc-machine\")"
        echo "[opc]   3. Key type: Authentication Key"
        echo "[opc]   4. Paste the line below into the Key field:"
        echo
        cat "$dir/github_opencode.pub"
        echo
        echo "[opc]   5. Click 'Add SSH key'."
        echo "[opc] ============================================================"
    fi

    printf '%s' "$dir" > "$SSH_KEY_DIR_FILE"
    chmod 600 "$SSH_KEY_DIR_FILE"
    echo "[opc] SSH key folder saved: $dir"
}

# Make freshly installed tools visible in this session
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

ensure_python
